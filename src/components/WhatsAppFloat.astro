---
import { getContent, whatsappUrl } from '../utils/content';
const { site } = getContent();
const url = whatsappUrl(site);
---

<a
  id="wa-float"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="wa-float"
>
  <!-- Pulse ring -->
  <span class="wa-pulse" aria-hidden="true"></span>

  <!-- Icon -->
  <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>

  <!-- Expandable label -->
  <span class="wa-label">Chat with us</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 80px;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0;
    background: #25D366;
    color: white;
    border-radius: 50px;
    padding: 14px;
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.45);
    text-decoration: none;
    overflow: hidden;
    max-width: 52px;         /* collapsed = icon only */
    transition:
      max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      padding   0.35s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.2s ease,
      transform  0.2s ease;

    /* entrance: slides in from right after 1.2s */
    opacity: 0;
    transform: translateX(80px);
    animation: wa-enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s forwards;
  }

  @keyframes wa-enter {
    to { opacity: 1; transform: translateX(0); }
  }

  /* Hover: expand to show label */
  .wa-float:hover {
    max-width: 200px;
    padding: 14px 20px 14px 14px;
    box-shadow: 0 10px 36px rgba(37, 211, 102, 0.55);
    transform: translateY(-2px);
    gap: 10px;
  }

  /* Icon */
  .wa-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  /* Label — hidden until hover */
  .wa-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    transition:
      opacity  0.25s ease 0.05s,
      max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .wa-float:hover .wa-label {
    opacity: 1;
    max-width: 140px;
  }

  /* Pulse ring */
  .wa-pulse {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #25D366;
    animation: pulse 2.5s ease-out 2s infinite;
    pointer-events: none;
  }
  @keyframes pulse {
    0%   { transform: scale(1);   opacity: 0.6; }
    70%  { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Mobile: pin to bottom-right, slightly smaller */
  @media (max-width: 640px) {
    .wa-float {
      right: 16px;
      bottom: 20px;
      padding: 12px;
      max-width: 48px;
    }
    .wa-float:hover {
      padding: 12px 18px 12px 12px;
    }
    .wa-icon { width: 22px; height: 22px; }
  }
</style>
