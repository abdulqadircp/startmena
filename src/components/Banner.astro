---
import { getContent } from '../utils/content';
const { banner } = getContent();
---

{banner.enabled && (
  <div
    id="site-banner"
    data-type={banner.type}
    data-dismissible={banner.dismissible.toString()}
    aria-live="polite"
  >
    {banner.type === 'bar' && (
      <div
        class="banner-bar"
        style={`background:${banner.bg_color};color:${banner.text_color};`}
        role="region"
        aria-label="Announcement"
      >
        <div class="banner-bar-inner">
          <span class="banner-bar-message">{banner.message}</span>
          {banner.cta_text && banner.cta_link && (
            <a href={banner.cta_link} class="banner-bar-cta" style={`color:${banner.text_color};border-color:${banner.text_color};`}>
              {banner.cta_text}
            </a>
          )}
        </div>
        {banner.dismissible && (
          <button class="banner-dismiss" id="banner-dismiss" aria-label="Close announcement" style={`color:${banner.text_color};`}>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
            </svg>
          </button>
        )}
      </div>
    )}

    {banner.type === 'popup' && (
      <div class="banner-popup" role="dialog" aria-modal="true" aria-label="Special offer">
        <div class="popup-backdrop" id="popup-backdrop"></div>
        <div class="popup-card" style={`background:${banner.bg_color};color:${banner.text_color};`}>
          {banner.dismissible && (
            <button class="banner-dismiss popup-dismiss" id="banner-dismiss" aria-label="Close popup" style={`color:${banner.text_color};`}>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
              </svg>
            </button>
          )}
          <p class="popup-message">{banner.message}</p>
          {banner.subtext && <p class="popup-subtext" style={`color:${banner.text_color};opacity:0.8;`}>{banner.subtext}</p>}
          {banner.cta_text && banner.cta_link && (
            <a href={banner.cta_link} class="popup-cta" style={`color:${banner.bg_color};background:${banner.text_color};`}>
              {banner.cta_text}
            </a>
          )}
        </div>
      </div>
    )}
  </div>
)}

<style>
  /* ── Bar ──────────────────────────────────────────── */
  .banner-bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    height: 44px;
    display: flex; align-items: center;
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .banner-bar.visible { transform: translateY(0); }

  .banner-bar-inner {
    flex: 1; display: flex; align-items: center; justify-content: center;
    gap: 14px; padding: 0 48px 0 16px;
    font-size: 0.875rem; font-weight: 500;
  }
  .banner-bar-message { line-height: 1.3; }
  .banner-bar-cta {
    font-size: 0.8125rem; font-weight: 700;
    border: 1.5px solid currentColor; border-radius: 5px;
    padding: 3px 10px; text-decoration: none; white-space: nowrap;
    transition: opacity 0.2s;
  }
  .banner-bar-cta:hover { opacity: 0.75; }

  /* Dismiss button (shared) */
  .banner-dismiss {
    background: none; border: none; cursor: pointer;
    padding: 8px; opacity: 0.7; transition: opacity 0.2s;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
  }
  .banner-dismiss:hover { opacity: 1; background: rgba(0,0,0,0.08); }

  /* Bar dismiss – pinned to right edge */
  .banner-bar .banner-dismiss {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
  }

  /* Push navbar down when bar is visible */
  :global(body.has-banner #navbar) {
    top: 44px !important;
    transition: top 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Popup ────────────────────────────────────────── */
  .banner-popup {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; opacity: 0;
    transition: opacity 0.3s ease;
  }
  .banner-popup.visible { pointer-events: auto; opacity: 1; }

  .popup-backdrop {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }

  .popup-card {
    position: relative; z-index: 1;
    width: 100%; max-width: 480px; margin: 16px;
    border-radius: 20px; padding: 40px 36px 36px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.25);
    transform: translateY(24px) scale(0.96);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .banner-popup.visible .popup-card { transform: translateY(0) scale(1); }

  .popup-dismiss {
    position: absolute; top: 14px; right: 14px;
  }
  .popup-message {
    font-size: 1.25rem; font-weight: 700; line-height: 1.4; margin-bottom: 10px;
  }
  .popup-subtext {
    font-size: 0.9375rem; line-height: 1.6; margin-bottom: 24px;
  }
  .popup-cta {
    display: inline-block;
    padding: 12px 28px; border-radius: 10px;
    font-size: 0.9375rem; font-weight: 700; text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }
  .popup-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
</style>

<script>
  const STORAGE_KEY = 'sm_banner_dismissed';

  function initBanner() {
    const root = document.getElementById('site-banner');
    if (!root) return;

    const type        = root.dataset.type as string;
    const dismissible = root.dataset.dismissible === 'true';

    // Don't show if already dismissed this session
    if (sessionStorage.getItem(STORAGE_KEY)) return;

    function dismiss() {
      if (type === 'bar') {
        document.querySelector('.banner-bar')?.classList.remove('visible');
        document.body.classList.remove('has-banner');
      } else {
        document.querySelector('.banner-popup')?.classList.remove('visible');
      }
      sessionStorage.setItem(STORAGE_KEY, '1');
    }

    if (type === 'bar') {
      const bar = document.querySelector('.banner-bar');
      document.body.classList.add('has-banner');
      // Small delay so CSS transition plays on first paint
      requestAnimationFrame(() => bar?.classList.add('visible'));

      if (dismissible) {
        document.getElementById('banner-dismiss')?.addEventListener('click', dismiss);
      }

    } else {
      const popup = document.querySelector('.banner-popup');
      // Appear after 1.5s so the page loads first
      setTimeout(() => popup?.classList.add('visible'), 1500);

      if (dismissible) {
        document.getElementById('banner-dismiss')?.addEventListener('click', dismiss);
        document.getElementById('popup-backdrop')?.addEventListener('click', dismiss);
      }
      // Keyboard: Escape closes
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') dismiss();
      }, { once: true });
    }
  }

  // Astro module scripts run after DOM is ready — call directly, no DOMContentLoaded needed
  initBanner();
</script>
